<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mesclado pelo Tauri no Info.plist do projeto iOS gerado (gen/apple).
     Sem estas chaves o iOS mata o app ao pedir mic/câmera (ditado e anexo
     por foto do ShvIA web) e a review da Apple rejeita o binário. -->
<plist version="1.0">
  <dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>O microfone é usado para ditar mensagens por voz no chat.</string>
    <key>NSCameraUsageDescription</key>
    <string>A câmera é usada para tirar fotos e anexá-las ao chat.</string>
    <!-- Face ID: sem esta chave o iOS mata o app na 1ª chamada ao Face ID (o
         gate de bloqueio local do M3). Touch ID não exige texto próprio. -->
    <key>NSFaceIDUsageDescription</key>
    <string>O Face ID desbloqueia o ShvIA localmente, sem digitar a senha a cada acesso.</string>
    <!-- Conformidade de exportação: o app só usa HTTPS/TLS padrão do sistema
         (tráfego pro ai.shvia.org), que é criptografia isenta. Declarar aqui
         evita a pergunta manual a CADA upload no TestFlight/App Store Connect. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Ciclo de vida por cenas: o iOS 27 derruba (SIGTRAP ao criar a primeira cena) o app
         compilado com o SDK 27 que não declara este manifesto. O tao 0.37 liga o modo cena
         quando a chave existe e entrega o `Resumed` (o rebloqueio) por ele. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
      <key>UIApplicationSupportsMultipleScenes</key>
      <false/>
      <key>UISceneConfigurations</key>
      <dict>
        <key>UIWindowSceneSessionRoleApplication</key>
        <array>
          <dict>
            <key>UISceneConfigurationName</key>
            <string>TaoScene</string>
            <key>UISceneDelegateClassName</key>
            <string>TaoSceneDelegate</string>
          </dict>
        </array>
      </dict>
    </dict>
  </dict>
</plist>
